# Copia este archivo como .env y rellena tus datos

# Token que te da @BotFather en Telegram
TELEGRAM_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Canal donde se publica el resumen diario (el bot debe ser administrador)
TELEGRAM_CANAL=@nombre_de_tu_canal

# Hora de publicación (hora de Madrid)
HORA_PUBLICACION=09:00

# Opcional: clave gratuita de https://www.football-data.org (respaldo para los partidos del día)
FOOTBALL_DATA_ORG_KEY=
