{
  "appId": "com.picksdorados.app",
  "appName": "Clávala",
  "webDir": "www",
  "server": {
    "url": "https://victormoreno172-sys.github.io/picks-dorados/",
    "allowNavigation": [
      "victormoreno172-sys.github.io"
    ],
    "errorPath": "sin-conexion.html"
  },
  "android": {
    "backgroundColor": "#0b1220"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1400,
      "launchAutoHide": true,
      "launchFadeOutDuration": 300,
      "backgroundColor": "#0b1220",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "LIGHT",
      "backgroundColor": "#f5f7fb"
    },
    "FirebaseMessaging": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}